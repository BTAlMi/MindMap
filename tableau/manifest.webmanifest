{
  "id": "./",
  "name": "Canopée — tableaux de cartes",
  "short_name": "Canopée",
  "description": "Tableaux de cartes libres : notes, images, liens, cadres et flèches. Compagnon de Ramure.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1B1E21",
  "theme_color": "#1B1E21",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-canopee+json": [".canopee"] } }
  ]
}
